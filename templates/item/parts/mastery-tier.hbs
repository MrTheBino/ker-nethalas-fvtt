<div class="tier-row">
    <label class='resource-label'>Tier {{tier.level}}</label>
    <div class="flexrow">
        <div class="tier-option">
            <div "tier-option-row"><input type='text' name='system.tier{{tier.level}}.option1.name'
                    value="{{tier.option1.name}}" data-dtype='String' placeholder="Name" /></div>
            <div "tier-option-row">
                <select name='system.tier{{tier.level}}.option1.actionType' data-dtype='String'>
                    <option value="">-</option>
                    <option value="1 Standard Action" {{#if (eq tier.option1.actionType "1 Standard Action")}}selected{{/if}}>1 Standard Action</option>
                    <option value="Passive" {{#if (eq tier.option1.actionType "Passive")}}selected{{/if}}>Passive</option>
                </select>
            </div>
            <div "tier-option-row">
                <input type='text' name='system.tier{{tier.level}}.option1.costValue'
                    value="{{tier.option1.costValue}}" data-dtype='String' placeholder="Cost" />
            </div>
            <div "tier-option-row">
                <textarea name='system.tier{{tier.level}}.option1.description' placeholder="Description">{{tier.option1.description}}</textarea>
            </div>
        </div>
        <div class="tier-option">
            <input type='text' name='system.tier{{tier.level}}.option2.name' value="{{tier.option2.name}}"
                data-dtype='String' />
            <div "tier-option-row">
                <select name='system.tier{{tier.level}}.option2.actionType' data-dtype='String'>
                    <option value="">-</option>
                    <option value="1 Standard Action" {{#if (eq tier.option2.actionType "1 Standard Action")}}selected{{/if}}>1 Standard Action</option>
                    <option value="Passive" {{#if (eq tier.option2.actionType "Passive")}}selected{{/if}}>Passive</option>
                </select>
            </div>
            <div "tier-option-row">
                <input type='text' name='system.tier{{tier.level}}.option2.costValue'
                    value="{{tier.option2.costValue}}" data-dtype='String' placeholder="Cost" />
            </div>
            <div "tier-option-row">
                <textarea name='system.tier{{tier.level}}.option2.description' placeholder="Description">{{tier.option2.description}}</textarea>
            </div>
        </div>
    </div>
</div>