<div class="resource flex-group-center">
    <label for="system.sanity.value" class="resource-label">Sanity</label>
    <div class="resource-content flexrow flex-center flex-between">
        <input type="text" name="system.sanity.value" value="{{system.sanity.value}}" data-dtype="Number" />
        <span> / </span>
        <input type="text" name="system.sanity.max" value="{{system.sanity.max}}" data-dtype="Number" />
    </div>
</div>

<div class="resource flex-group-center">
    <label for="system.sanity.value" class="resource-label">Lightsources</label>
    {{#each system.lightsources as |lightsource index|}}
        <input type="checkbox" {{#if lightsource}} checked{{/if}} data-key="system.lightsources" data-index="{{index}}" class="actor-array-update"/>
    {{/each}}
</div>